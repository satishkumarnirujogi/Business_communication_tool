# Copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------------------
# Demo mode and Docker
# ---------------------------------------------------------------------------
# true: an empty database is filled with the demo clinic and its documents on startup (never overwrites a
# database that already has doctors). Docker defaults to true; set false before setting up a real clinic.
DEMO_MODE=
# Docker only: the port the web apps are published on (default 8080). On a server behind an HTTPS proxy use
# 127.0.0.1:8080 so it isn't reachable directly.
PORT=
# Clinic name, address, timezone etc. live in config/clinic.yaml; business rules in config/rules.yaml.

# ---------------------------------------------------------------------------
# AI model (any provider supported by LiteLLM)
# ---------------------------------------------------------------------------
# Provider name, e.g. openrouter | openai | anthropic | mistral | groq | azure | gemini | ollama
LLM_PROVIDER=
# Model id at that provider, e.g. gpt-4o-mini, claude-haiku-5-5, anthropic/claude-haiku-5.5 (openrouter),
# llama-3.3-70b-versatile (groq), qwen3 (ollama). For azure, use your deployment name.
LLM_MODEL=
# API key from the provider's dashboard. Leave empty for local Ollama.
LLM_API_KEY=
# Only for self-hosted or custom endpoints, e.g. http://localhost:11434 (Ollama)
# or https://YOUR-RESOURCE.openai.azure.com (Azure OpenAI). Leave empty otherwise.
LLM_BASE_URL=
# How the assistant calls its tools: auto (default: native tool calls, falls back to JSON
# if the model rejects them) | native | json (for small local models without tool support)
LLM_TOOL_MODE=
# Optional tuning. Defaults: 60 seconds, 0.2, 2000.
LLM_TIMEOUT_SECONDS=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# Where clinic data lives: sqlite (default, no setup) | postgres | excel | google_sheets
# Excel and Google Sheets are for editing; bookings always go through a local SQLite database
# (which prevents double booking) and are written back to the spreadsheet.
DATA_SOURCE=
# SQLite file (default: data/clinic.db). Also used as the booking engine for excel / google_sheets.
SQLITE_PATH=
# postgres: connection string. For Supabase: Connect > Session pooler URI.
# URL-encode special characters in the password: '#' -> %23, '@' -> %40, '/' -> %2F, ':' -> %3A
DATABASE_URL=
# Supabase pooler host, for reference only (the app reads DATABASE_URL).
SUPABASE_POOLER_HOST=
# excel: path to the .xlsx file (default: data/clinic.xlsx). Start from templates/clinic_template.xlsx.
EXCEL_PATH=
# google_sheets: the id from the sheet URL (docs.google.com/spreadsheets/d/<THIS PART>/edit)
GOOGLE_SHEETS_ID=
# google_sheets: path to the service account JSON key (see docs/google-sheets.md)
GOOGLE_SERVICE_ACCOUNT_FILE=
# How often to pull edits from Excel / Google Sheets, in seconds (default 120)
SYNC_INTERVAL_SECONDS=

# ---------------------------------------------------------------------------
# Knowledge base (documents the assistant answers from)
# ---------------------------------------------------------------------------
# local (default): a multilingual model that runs on the server's CPU; downloaded once (~220 MB) into data/models.
# litellm: any embedding API LiteLLM supports, e.g. EMBEDDING_MODEL=openai/text-embedding-3-small.
EMBEDDING_PROVIDER=
# local default: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=
# litellm only. Leave empty to reuse LLM_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Where vectors are stored: auto (default: pgvector when DATA_SOURCE=postgres, else ChromaDB) | chroma | pgvector
KB_VECTOR_STORE=
# ChromaDB folder (default: data/chroma)
CHROMA_PATH=
# A Chroma server instead of the embedded one (docker-compose.yml sets these: chroma / 8000)
CHROMA_HOST=
CHROMA_PORT=
# Minimum similarity (0-1) for a passage to be shown to the model (default 0.30). Raise it if answers use
# unrelated documents; lower it if the assistant misses answers that are in the documents.
KB_MIN_SCORE=
# Allow importing URLs on private networks (intranet pages). Default false.
KB_ALLOW_PRIVATE_URLS=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Long random string. Send it as the X-Admin-Token header to /api/audit and /api/admin/*.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Channels: WhatsApp, email, reminders (all optional; also editable in Admin → Settings → Channels)
# ---------------------------------------------------------------------------
# The address the internet reaches this server at. Webhooks and Twilio's signature check need it.
PUBLIC_BASE_URL=
# none (default) | twilio | meta. Guide: docs/whatsapp.md
WHATSAPP_PROVIDER=none
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The clinic's WhatsApp sender in international format, e.g. +4930123456
TWILIO_WHATSAPP_NUMBER=
# Approved content template for reminders (HX...), variables {{1}} name {{2}} date and time {{3}} doctor {{4}} reference
TWILIO_REMINDER_CONTENT_SID=
# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any long random text; enter the same in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Default v23.0
WHATSAPP_GRAPH_VERSION=
# Approved template name (en + de) with the same four body variables as above
WHATSAPP_REMINDER_TEMPLATE=

# Email: the assistant answers mail to this inbox (IMAP in, SMTP out). Use a dedicated mailbox.
EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_DISPLAY_NAME=
IMAP_HOST=
# 993 (SSL, default) or 143 (STARTTLS)
IMAP_PORT=
# Defaults to EMAIL_ADDRESS
IMAP_USER=
IMAP_PASSWORD=
# Default INBOX
IMAP_FOLDER=
SMTP_HOST=
# 587 with starttls (default), 465 with ssl
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# How often to check the inbox, in seconds (default 60)
EMAIL_POLL_SECONDS=

# Day-before reminders through the channel the patient booked on (web chat/staff bookings: email)
REMINDERS_ENABLED=true
# Clinic local time on the day before (default 10:00)
REMINDER_SEND_TIME=
# Skip the reminder if the appointment starts sooner than this (hours, default 3)
REMINDER_MIN_HOURS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Folder containing clinic.yaml and rules.yaml (default: ./config next to this file).
CONFIG_DIR=
# DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=
# Override any clinic.yaml field with CLINIC_<FIELD>, e.g. CLINIC_NAME=, CLINIC_TIMEZONE=,
# CLINIC_BRANDING__PRIMARY_COLOR=
